# Copy to config/.env. Python reads this file directly for live updates.
# Camera (use CAMERA_DEVICE=0 for native macOS)
CAMERA_DEVICE=/dev/video0
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080
# Linux capture format: MJPG means MJPEG. macOS chooses its native format.
CAMERA_FORMAT=MJPG
CAMERA_FPS=25
# Workaround: stream for 5 seconds, release for 20 seconds, repeat.
CAMERA_CYCLE_ENABLED=false
# Open once per interval, release before detection, save only if a person is found.
# Snapshot mode overrides continuous capture and CAMERA_CYCLE_ENABLED.
CAMERA_SNAPSHOT_ENABLED=false
DETECTION_INTERVAL=3
PERSON_CONFIDENCE=0.5
EMPTY_TIMEOUT=30

# Capture
CAPTURE_ENABLED=true
MIN_CAPTURE_INTERVAL=120
MAX_CAPTURE_INTERVAL=300
# Random cooldown for movement-triggered photos in continuous mode.
MIN_MOTION_INTERVAL=2
MAX_MOTION_INTERVAL=5

# Gallery
SHOW_HIDDEN=true
SHOW_HIDDEN_BUTTON=true

# Storage
PHOTO_DIR=./photos

# Server (port changes require an application restart)
PORT=5418
