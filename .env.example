# Copy to config/.env. Python reads this file directly for live updates.
# Camera (use CAMERA_DEVICE=0 for native macOS)
CAMERA_DEVICE=/dev/video0
DETECTION_INTERVAL=3
PERSON_CONFIDENCE=0.5
EMPTY_TIMEOUT=30

# Capture
CAPTURE_ENABLED=true
MIN_CAPTURE_INTERVAL=60
MAX_CAPTURE_INTERVAL=300

# Storage
PHOTO_DIR=./photos

# Server (port changes require an application restart)
PORT=5418
